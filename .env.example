# Optional: enables Google sign-in + cross-device sync (Supabase).
# Leave both unset and the app runs local-only, exactly as before.
# Both values are PUBLIC by design. NEVER put a secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
